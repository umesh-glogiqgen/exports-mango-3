{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exports-mango-3",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  }
}
